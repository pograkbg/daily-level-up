# 복사해서 .env.local 파일을 만든 뒤 값을 채우세요.
# .env.local 은 깃에 올라가지 않도록 .gitignore 에 이미 포함되어 있습니다.

# mock = 가짜 데이터로 화면 확인 (지금 단계)
# supabase = 실제 DB 사용 (2단계 이후)
DATA_SOURCE=mock

# 영어 음성 파일 (dictionaryapi.dev). 비워 두면 기기 음성을 씁니다.
# 음성 파일 재생을 켜려면 아래 주석을 풀고 dictionaryapi 로 바꾸세요.
# ENGLISH_AUDIO=dictionaryapi

# 2단계에서 Supabase 프로젝트를 만든 뒤 채워 넣습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 가입 승인 메일 (Gmail). 비워 두면 메일을 보내지 않고 가입·승인만 진행됩니다.
# Google 계정에서 2단계 인증을 켠 뒤 "앱 비밀번호"(16자리)를 만들어 넣으세요.
# GMAIL_USER=내계정@gmail.com
# GMAIL_APP_PASSWORD=
# 가입 신청 알림을 받을 관리자 주소 (쉼표로 여러 개 가능)
# ADMIN_NOTIFY_EMAIL=
# 메일 안의 링크에 쓸 사이트 주소 (배포 후에는 실제 주소로 바꾸세요)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 승인 확인 캐시(쿠키) 서명용 비밀 값. 16자 이상 임의 문자열. 비워 두면 캐시를 쓰지 않습니다.
# APPROVAL_COOKIE_SECRET=
